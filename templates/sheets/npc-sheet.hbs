<div class="tinyd6-sheet actor-sheet {{cssClass}}">
    <header class="sheet-identity"><img src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="{{actor.name}}"/><div><p class="sheet-kicker">{{localize "tinyd6.actor.npc"}}</p><input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'tinyd6.actor.name'}}"/></div></header>
    <section class="sheet-card"><h2>{{localize "tinyd6.actor.npc"}}</h2><div class="sheet-editor"><h3>{{localize "tinyd6.actor.description"}}</h3>{{#if editable}}<prose-mirror name="system.description" data-document-u-u-i-d="{{actor.uuid}}" value="{{data.system.description}}" collaborate="true" toggled="true">{{{descriptionHTML}}}</prose-mirror>{{else}}{{{descriptionHTML}}}{{/if}}</div>{{#if config.enableCorruption}}<label class="sheet-field">{{localize "tinyd6.actor.corruption.test"}}<select name="system.corruptionTest">{{selectOptions config.corruptionTests selected=data.system.corruptionTest localize="true"}}</select></label>{{/if}}</section>
    <section class="sheet-card meter-card"><div class="meter-heading"><h2>{{localize "tinyd6.actor.wounds.header"}}</h2><label>{{localize "tinyd6.actor.wounds.max"}}<input name="system.wounds.max" type="number" value="{{data.system.wounds.max}}"/></label></div><div class="meter">{{#times data.system.wounds.max}}<input type="checkbox" data-meter="wounds" {{#if (lt . ../data.system.wounds.value)}}checked{{/if}}/>{{/times}}</div><p class="help">{{localize "tinyd6.actor.wounds.help"}}</p></section>
    <section class="sheet-card"><div class="section-title"><h2>{{localize "tinyd6.actor.traits"}}</h2><button type="button" data-action="createItem" data-type="trait"><i class="fas fa-plus"></i> {{localize "tinyd6.sheet.newItem"}}</button></div><ul class="sheet-list">{{#each inventory.traits as |trait|}}{{> "systems/tinyd6/templates/partials/trait-block.hbs" trait=trait}}{{/each}}</ul></section>
</div>
