<div class="tinyd6-sheet item-sheet {{cssClass}}">{{> "systems/tinyd6/templates/partials/item-header.hbs" placeholder="tinyd6.armor.name"}}<section class="sheet-card"><div class="sheet-fields three-columns"><label>{{localize "tinyd6.armor.type"}}<select name="system.group">{{selectOptions config.armorTypes selected=data.system.group localize="true"}}</select></label><label>{{localize "tinyd6.armor.damageReduction"}}<input name="system.damageReduction" type="number" value="{{data.system.damageReduction}}"/></label><label>{{localize "tinyd6.armor.slots"}}<input name="system.slots.value" type="number" value="{{data.system.slots.value}}"/></label></div><div class="sheet-editor"><h2>{{localize "tinyd6.sheet.description"}}</h2>{{#if editable}}<prose-mirror name="system.description" data-document-u-u-i-d="{{item.uuid}}" value="{{data.system.description}}" collaborate="true" toggled="true">{{{descriptionHTML}}}</prose-mirror>{{else}}{{{descriptionHTML}}}{{/if}}</div></section></div>
