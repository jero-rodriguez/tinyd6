<div class="tinyd6-sheet item-sheet {{cssClass}}">{{> "systems/tinyd6/templates/partials/item-header.hbs" placeholder="tinyd6.trait.name"}}<section class="sheet-card"><div class="sheet-fields two-columns"><label>{{localize "tinyd6.heritage.startingHealth"}}<input name="system.startingHealth" type="number" value="{{data.system.startingHealth}}"/></label><label>{{localize "tinyd6.heritage.corruptionThreshold"}}<input name="system.corruptionThreshold" type="number" value="{{data.system.corruptionThreshold}}"/></label></div><div class="sheet-editor"><h2>{{localize "tinyd6.sheet.description"}}</h2>{{#if editable}}<prose-mirror name="system.description" data-document-u-u-i-d="{{item.uuid}}" value="{{data.system.description}}" collaborate="true" toggled="true">{{{descriptionHTML}}}</prose-mirror>{{else}}{{{descriptionHTML}}}{{/if}}</div><div class="sheet-editor"><h2>{{localize "tinyd6.heritage.trait"}}</h2>{{#if editable}}<prose-mirror name="system.trait" data-document-u-u-i-d="{{item.uuid}}" value="{{data.system.trait}}" collaborate="true" toggled="true">{{{traitHTML}}}</prose-mirror>{{else}}{{{traitHTML}}}{{/if}}</div></section></div>
